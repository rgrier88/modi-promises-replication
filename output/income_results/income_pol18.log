. local main_pred "rgdppc(1986) rgdppc(1991) rgdppc(1996) rgdppc(2001) rgdppc(2006) rgdppc(2011) $covs"

. local lags ""

. forvalues y = 1984/2013 {
  2.     local lags `lags' rgdppc(`y')
  3. }

. 
. run18 main    2014 2023 "`main_pred'"
