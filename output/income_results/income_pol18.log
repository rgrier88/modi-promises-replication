. * --- estimate one model, print and save results ----------------------------------
. capture program drop run18

. program define run18
  1.     args stub trper endyr pred
  2. 
.     load18 `endyr'
  3.     quietly levelsof id if iso3code == "IND", local(tr)
  4.     synth rgdppc `pred', trunit(`tr') trperiod(`trper') nested allopt ///
>         keep("$out/keep_`stub'") replace
  5. 
.     load18 `endyr'
  6.     synth_runner rgdppc `pred', trunit(`tr') trperiod(`trper') nested allopt
  7.     local jp = e(pval_joint_post_std)
  8.     local np = e(n_pl_used)
  9.     local nt = e(n_pl)
 10.     matrix P = e(pvals_std)
 11. 
.     use "$out/keep_`stub'", clear
 12.     keep _time _Y_treated _Y_synthetic
 13.     drop if _time == .
 14.     rename _time year
 15.     gen effect = _Y_treated - _Y_synthetic
 16.     gen pre2 = effect^2 if year < `trper'
 17.     quietly summarize pre2
 18.     local rmspe = sqrt(r(mean))
 19.     keep if year >= `trper'
 20.     gen lead = _n
 21.     gen pval = .
 22.     forvalues j = 1/`=colsof(P)' {
 23.         quietly replace pval = round(P[1,`j'], .01) in `j'
 24.     }
 25.     keep year lead effect pval
 26.     save "$out/pvals_`stub'", replace
 27. 
.     display as result _newline "=== `stub' (18 donors): treatment `trper', 1984-`endyr' ==="
 28.     display as result "pre-treatment RMSPE = " %6.1f `rmspe' ///
>         "   joint p (std) = " %5.2f `jp' "   placebos used = `np' of `nt'"
 29.     format effect %8.1f
 30.     list year effect pval, noobs sep(0)
 31. 
.     * weights (Poland's weight is the number to watch)
.     use "$out/keep_`stub'", clear
 32.     keep _Co_Number _W_Weight
 33.     drop if _Co_Number == . | _W_Weight < .001
 34.     rename _Co_Number id
 35.     tempfile w
 36.     save `w'
 37.     load18 `endyr'
 38.     keep id iso3code
 39.     duplicates drop
 40.     merge 1:1 id using `w', nogenerate keep(match)
 41.     gsort -_W_Weight
 42.     format _W_Weight %6.3f
 43.     list iso3code _W_Weight, noobs sep(0)
 44. end

. 
. * --- side-by-side: 17-donor (Income_Results) vs 18-donor (this run) ---------------
. capture program drop compare18

. program define compare18
  1.     args stub
  2.     use "$out17/pvals_`stub'", clear
  3.     rename effect effect17
  4.     rename pval   pval17
  5.     merge 1:1 year using "$out/pvals_`stub'", nogenerate
  6.     rename effect effect18
  7.     rename pval   pval18
  8.     gen diff = effect18 - effect17
  9.     format effect17 effect18 diff %8.1f
 10.     display as result _newline "=== `stub': 17-donor vs 18-donor (with Poland) ==="
 11.     list year effect17 pval17 effect18 pval18 diff, noobs sep(0)
 12. end

. 
