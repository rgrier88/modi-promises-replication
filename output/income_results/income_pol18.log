. * 17-donor pool + POL
. global donors "CHN IDN BRA BGD PAK MEX VNM PHL THA TUR EGY KOR ETH ZAF ARG MMR COD POL"

. global covs   "csh_g hc csh_x csh_i"

. 
. * --- load India + donors, 1984 to endyr ------------------------------------------
. capture program drop load18

. program define load18
  1.     args endyr
  2.     use "$data", clear
  3.     gen byte keepme = iso3code == "IND"
  4.     foreach c of global donors {
  5.         replace keepme = 1 if iso3code == "`c'"
  6.     }
  7.     keep if keepme & year >= 1984 & year <= `endyr'
  8.     egen id = group(iso3code)
  9.     tsset id year
 10. end

. 
. * --- data check (Poland especially) -----------------------------------------------
. load18 2023
