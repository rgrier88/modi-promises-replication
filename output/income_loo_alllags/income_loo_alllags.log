. 
. global donors "CHN IDN BRA BGD PAK MEX VNM PHL THA TUR EGY KOR ETH ZAF ARG MMR COD POL"

. 
. * --- load India + donors, 1984-2023, optionally dropping one donor ---------------
. capture program drop load18

. program define load18
  1.     args dropc
  2.     use "$data", clear
  3.     gen byte keepme = iso3code == "IND"
  4.     foreach c of global donors {
  5.         replace keepme = 1 if iso3code == "`c'"
  6.     }
  7.     if "`dropc'" != "" replace keepme = 0 if iso3code == "`dropc'"
  8.     keep if keepme & year >= 1984 & year <= 2023
  9.     egen id = group(iso3code)
 10.     tsset id year
 11. end

. 
. * --- all-lags predictor list -----------------------------------------------------
. local lags ""

. forvalues y = 1984/2013 {
  2.     local lags `lags' rgdppc(`y')
  3. }

. 
. * --- one run: synth (weights, paths), synth_runner (p-values), save results -------
. capture program drop loo18

. program define loo18
  1.     args stub dropc pred
  2. 
.     * 1. synth: point estimate, weights, India / synthetic paths
.     load18 `dropc'
  3.     quietly levelsof id if iso3code == "IND", local(tr)
  4.     quietly count if year == 1984
  5.     local ndon = r(N) - 1
  6.     display as result _newline "==== all-lags model, dropping: `dropc' (`ndon' donors) ===="
  7.     synth rgdppc `pred', trunit(`tr') trperiod(2014) nested allopt ///
>         keep("$out/keep_loo_`stub'") replace
  8. 
.     * 2. synth_runner: standardized yearly p-values and RMSPE-ratio p-value
.     load18 `dropc'
  9.     synth_runner rgdppc `pred', trunit(`tr') trperiod(2014) nested allopt
 10.     local jp_std   = e(pval_joint_post_std)
 11.     local jp_ratio = e(pval_joint_post)
 12.     local np = e(n_pl_used)
 13.     local nt = e(n_pl)
 14.     matrix P = e(pvals_std)
 15.     * rank among the units compared: placebos with a larger post/pre ratio + 1
.     local rank = round(`jp_ratio' * `np') + 1
 16. 
.     * 3. yearly effects and p-values (Table A1 column for this model)
.     use "$out/keep_loo_`stub'", clear
 17.     keep _time _Y_treated _Y_synthetic
 18.     drop if _time == .
 19.     rename _time year
 20.     gen effect = _Y_treated - _Y_synthetic
 21.     gen pre2 = effect^2 if year < 2014
 22.     quietly summarize pre2
 23.     local rmspe = sqrt(r(mean))
 24.     preserve
 25.         keep if year >= 2014
 26.         gen lead = _n
 27.         gen pval = .
 28.         forvalues j = 1/`=colsof(P)' {
 29.             quietly replace pval = round(P[1,`j'], .01) in `j'
 30.         }
 31.         keep year lead effect pval
 32.         gen model = "`stub'"
 33.         save "$out/pvals_loo_`stub'", replace
 34.         display as result "pre-treatment RMSPE = " %6.1f `rmspe' ///
>             "   joint p (std) = " %5.2f `jp_std' ///
>             "   post/pre ratio: rank `rank' of `=`np'+1' (p = " %4.2f `jp_ratio' ")" ///
>             "   placebos used = `np' of `nt'"
 35.         format effect %8.1f
 36.         list year effect pval, noobs sep(0)
 37.     restore
 38.     * India and synthetic India in levels, for Figure 5
.     rename _Y_treated india
 39.     rename _Y_synthetic synth_`stub'
 40.     gen gap_`stub' = effect
 41.     keep year india synth_`stub' gap_`stub'
 42.     save "$out/paths_loo_`stub'", replace
 43. 
.     * 4. donor weights, named
.     use "$out/keep_loo_`stub'", clear
 44.     keep _Co_Number _W_Weight
 45.     drop if _Co_Number == . | _W_Weight < .001
 46.     rename _Co_Number id
 47.     tempfile w
 48.     save `w'
 49.     load18 `dropc'
 50.     keep id iso3code
 51.     duplicates drop
 52.     merge 1:1 id using `w', nogenerate keep(match)
 53.     gsort -_W_Weight
 54.     format _W_Weight %6.3f
 55.     list iso3code _W_Weight, noobs sep(0)
 56.     gen model = "`stub'"
 57.     save "$out/weights_loo_`stub'", replace
 58. end

. 
. ********************************************************************************
. * RUN
. ********************************************************************************
. 
. loo18 all   ""    "`lags'"
