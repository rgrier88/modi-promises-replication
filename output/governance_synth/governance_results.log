. * --- load India + donors, dropping donors with the outcome missing anywhere ---------
. capture program drop load24

. program define load24
  1.     args v startyr
  2.     use "$data", clear
  3.     gen byte keepme = iso3code == "IND"
  4.     foreach c of global donors {
  5.         replace keepme = 1 if iso3code == "`c'"
  6.     }
  7.     keep if keepme & year >= `startyr' & year <= 2023
  8.     gen byte miss = `v' >= .
  9.     bysort iso3code: egen anymiss = max(miss)
 10.     quietly levelsof iso3code if anymiss & iso3code != "IND", local(dropped) clean
 11.     if "`dropped'" != "" display as error "`v': dropped for missing outcome in some sample year: `dropped'"
 12.     drop if anymiss & iso3code != "IND"
 13.     drop miss anymiss
 14.     egen id = group(iso3code)
 15.     tsset id year
 16. end

. 
. * --- summary table collector -------------------------------------------------------
. tempname T

. postfile `T' str32 indicator str16 v double(pre_rmspe eff_2014 eff_2023 joint_p n_placebos) ///
>     using "$out/table2_values.dta", replace

. 
. * --- one outcome ------------------------------------------------------------------------
. capture program drop run24

. program define run24
  1.     args v startyr lags ytit name slug xl
  2. 
.     display as result _newline(2) "==================== `v' (`ytit'), sample `startyr'-2023 ===================="
  3. 
.     load24 `v' `startyr'
  4.     quietly levelsof id if iso3code == "IND", local(tr)
  5.     synth `v' `lags' $covs, trunit(`tr') trperiod(2014) nested allopt ///
>         keep("$out/keep_`v'") replace
  6. 
.     load24 `v' `startyr'
  7.     synth_runner `v' `lags' $covs, trunit(`tr') trperiod(2014) nested allopt
  8.     local jp = e(pval_joint_post_std)
  9.     local np = e(n_pl_used)
 10.     local nt = e(n_pl)
 11.     matrix P = e(pvals_std)
 12. 
.     * annual effects + p-values
.     use "$out/keep_`v'", clear
 13.     keep _time _Y_treated _Y_synthetic
 14.     drop if _time == .
 15.     rename _time year
 16.     gen effect = _Y_treated - _Y_synthetic
 17.     gen pre2 = effect^2 if year < 2014
 18.     quietly summarize pre2
 19.     local rmspe = sqrt(r(mean))
 20.     keep if year >= 2014
 21.     gen lead = _n
 22.     gen pval = .
 23.     forvalues j = 1/`=colsof(P)' {
 24.         quietly replace pval = round(P[1,`j'], .01) in `j'
 25.     }
 26.     quietly summarize effect if year == 2014
 27.     local e14 = r(mean)
 28.     quietly summarize effect if year == 2023
 29.     local e23 = r(mean)
 30.     keep year lead effect pval
 31.     save "$out/pvals_`v'", replace
 32. 
.     display as result "pre-treatment RMSPE = " %7.4f `rmspe' ///
>         "   joint p (std) = " %5.2f `jp' "   placebos used = `np' of `nt'"
 33.     format effect %8.3f
 34.     list year effect pval, noobs sep(0)
 35.     post $T ("`name'") ("`v'") (`rmspe') (`e14') (`e23') (`jp') (`np')
 36. 
.     * named weights
.     use "$out/keep_`v'", clear
 37.     keep _Co_Number _W_Weight
 38.     drop if _Co_Number == . | _W_Weight < .001
 39.     rename _Co_Number id
 40.     tempfile w
 41.     save `w'
 42.     load24 `v' `startyr'
 43.     keep id iso3code
 44.     duplicates drop
 45.     merge 1:1 id using `w', nogenerate keep(match)
 46.     gsort -_W_Weight
 47.     format _W_Weight %6.3f
 48.     list iso3code _W_Weight, noobs sep(0)
 49. 
.     * figures, paper style
.     use "$out/keep_`v'", clear
 50.     drop if _time == .
 51.     twoway (line _Y_treated _time, lcolor(black) lwidth(medthick)) ///
>            (line _Y_synthetic _time, lpattern(dash) lcolor(gs10) lwidth(medthick)), ///
>         title("A. Trends in `ytit'", size(medium)) ///
>         xline(2013, lpattern(dash)) ///
>         xtitle("Year") ytitle("`ytit'") xlabel(`xl') ///
>         legend(order(1 "India" 2 "Synthetic India") rows(1) size(small) region(style(none))) ///
>         plotregion(style(none)) graphregion(color(white))
 52.     graph export "$out/Fig_`slug'_trends.pdf", as(pdf) replace
 53. 
.     use "$out/pvals_`v'", clear
 54.     quietly summarize lead
 55.     twoway (bar effect lead, base(0) barwidth(.5) fcolor(gs11) lcolor(gs8)) ///
>            (scatter effect lead, mlabel(pval) mlabcolor(black) msymbol(i) mlabpos(6)), ///
>         title("B. Treatment effects and p-values", size(medium)) ///
>         xtitle("Years since Modi became Prime Minister") ytitle("Treatment Effect") ///
>         xlabel(1(1)`r(max)') yline(0, lcolor(black)) legend(off) ///
>         plotregion(style(none)) graphregion(color(white))
 56.     graph export "$out/Fig_`slug'_pvals.pdf", as(pdf) replace
 57. end

. 
. ********************************************************************************
. * RUN
. ********************************************************************************
. 
. global T `T'

. foreach v of local outcomesA {
  2.     run24 `v' 1984 "`v'(1986) `v'(1991) `v'(1996) `v'(2001) `v'(2006) `v'(2011)" ///
>         "`y_`v''" "`n_`v''" "`f_`v''" "`xl_`v''"
  3. }


